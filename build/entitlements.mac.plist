<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for the Electron helper / main process to keep running -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Hardened runtime: allow outgoing network (OpenAI / OpenAI-compatible APIs) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Read / write user-selected files (e.g. exported mindmap JSON / PNG) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>

    <!-- Downloads folder access for Export-to-file flows (Phase 1) -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>

    <!-- Disable library validation so unsigned helper processes can run -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
