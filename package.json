{
  "name": "progressive-mindmap",
  "version": "1.0.0",
  "description": "AI-powered progressive mindmap — extract structured knowledge from LLM conversations with streaming visualization and incremental updates",
  "type": "module",
  "license": "MIT",
  "author": "web4zn",
  "repository": {
    "type": "git",
    "url": "https://github.com/web4zn/progressive-mindmap"
  },
  "bugs": {
    "url": "https://github.com/web4zn/progressive-mindmap/issues"
  },
  "homepage": "https://github.com/web4zn/progressive-mindmap#readme",
  "keywords": [
    "mindmap",
    "llm",
    "ai",
    "knowledge-graph",
    "react",
    "typescript",
    "react-flow",
    "openai",
    "chat",
    "visualization"
  ],
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "electron-vite build && electron-builder --win --publish never",
    "build:mac": "electron-vite build && electron-builder --mac --publish never",
    "build:linux": "electron-vite build && electron-builder --linux --publish never",
    "preview": "electron-vite preview",
    "typecheck": "npx tsc --noEmit && npx tsc --noEmit -p electron/tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "smoke:electron": "node scripts/smoke-electron.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.63",
    "@base-ui/react": "^1.4.1",
    "@dagrejs/dagre": "^3.0.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "@xyflow/react": "^12.10.2",
    "ai": "^6.0.176",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.2",
    "electron-updater": "^6.8.9",
    "html-to-image": "^1.11.11",
    "idb": "^8.0.3",
    "js-beautify": "^1.15.4",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.5",
    "next-themes": "^0.4.6",
    "openai": "^6.35.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.3.3",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.3",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.59.2",
    "typescript-language-server": "^5.1.3",
    "vite": "^6.0.1",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "com.progressivemindmap.app",
    "productName": "Progressive Mindmap",
    "directories": {
      "output": "release/${version}",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office"
    }
  }
}
