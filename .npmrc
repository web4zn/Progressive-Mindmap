# Use the China-region mirror for npm registry + Electron / electron-builder
# binary downloads. Non-China developers can replace the registry line with
# https://registry.npmjs.org/ if their network cannot reach npmmirror.com.
#
# The Electron and electron-builder-binary lines are read by:
#   - @electron/get (npm install hook for `electron`)
#   - app-builder-bin (npm install hook for `electron-builder`)
#
# Removing the file is safe — it only re-routes the download mirrors.
registry=https://registry.npmmirror.com/
electron_mirror=https://cdn.npmmirror.com/binaries/electron/
electron_builder_binaries_mirror=https://cdn.npmmirror.com/binaries/electron-builder-binaries/
